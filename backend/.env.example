# ─────────────────────────────────────────────────────────────────────────────
# AI Outfit Image Generation Tool — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
DEBUG=false
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# ── Google Cloud Setup ────────────────────────────────────────────────────────
# 1. Create a project at https://console.cloud.google.com
# 2. Enable Vertex AI API
# 3. Create a service account, grant it "Vertex AI User" role
# 4. Download the JSON key and set the path below
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# ── Nano Banana 2 Model ───────────────────────────────────────────────────────
# The model is hosted on Vertex AI. The endpoint is auto-built from
# GOOGLE_CLOUD_PROJECT + GOOGLE_CLOUD_LOCATION + NANO_BANANA_MODEL_ID.
# Override NANO_BANANA_ENDPOINT only if using a custom endpoint.
NANO_BANANA_MODEL_ID=nano-banana-2
# NANO_BANANA_ENDPOINT=https://us-central1-aiplatform.googleapis.com/...

# ── Storage ───────────────────────────────────────────────────────────────────
# Leave empty to use defaults (./storage/uploads, ./storage/outputs)
# UPLOAD_DIR=/custom/path/uploads
# OUTPUT_DIR=/custom/path/outputs

# ── Generation Defaults ───────────────────────────────────────────────────────
DEFAULT_IMAGES_PER_OUTFIT=4
MAX_IMAGES_PER_OUTFIT=10
OUTPUT_IMAGE_WIDTH=1024
OUTPUT_IMAGE_HEIGHT=1365
GENERATION_TIMEOUT_SEC=120

# ── Google Drive (optional) ───────────────────────────────────────────────────
GOOGLE_DRIVE_ENABLED=true
